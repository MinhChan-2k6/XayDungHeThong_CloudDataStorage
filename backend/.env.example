# Copy to backend/.env. Do NOT commit .env.
SECRET_KEY=REPLACE_WITH_RANDOM_64_HEX_CHARS
DATABASE_URL=mysql+pymysql://cloudds_app:CHANGE_THIS@127.0.0.1:3306/cloudds
COOKIE_SECURE=false
SERVE_FRONTEND=true

# Configure Garage S3 keys/bucket before using upload/download.
GARAGE_ENDPOINT=http://127.0.0.1:3900
GARAGE_REGION=garage
GARAGE_BUCKET=cloudds-files
GARAGE_ACCESS_KEY=
GARAGE_SECRET_KEY=

# Obtain the 3 values below from a REAL VNPay Sandbox merchant account.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://YOUR_PUBLIC_HOST/api/v1/payments/vnpay/return
